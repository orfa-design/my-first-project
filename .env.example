# Рядок підключення до PostgreSQL (Supabase → Transaction pooler, порт 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Пароль для входу на сайт (ним же підписується cookie сесії)
APP_PASSWORD=
# Токен для AI-доступу через /api/hub (≥ 32 символів)
HUB_TOKEN=

# Для CLI без прямого доступу до бази (хмарні сесії Claude Code):
# HUB_URL=https://your-app.vercel.app
